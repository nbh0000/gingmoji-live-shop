<%- include('../partials/head', { title: p.name, bodyClass: '' }) %>
<main class="wrap page">
  <div class="page-title"><a class="back" href="/" aria-label="뒤로">←</a></div>
  <div class="panel">
    <div class="p-gallery" style="margin:0;padding:0">
      <% if (p.images.length) { p.images.forEach(function (img) { %>
        <div class="thumb"><img src="/img/<%= img.id %>" alt="<%= p.name %>"></div>
      <% }) } else { %><div class="thumb"><span class="ph">?</span></div><% } %>
    </div>
    <h1 class="p-name"><%= p.name %></h1>
    <div class="<%= showPrice ? 'p-price' : 'price hidden' %>"><%= showPrice ? fmt.won(p.price) : '가격은 방송 중에 공개됩니다' %></div>
    <div class="p-meta">
      <% if (p.is_soldout || p.stock <= 0) { %><span class="chip gray">품절</span><% } else if (s.show_stock) { %><span class="chip">재고 <%= p.stock %>개</span><% } %>
      <% if (p.use_open_option) { %><span class="chip gray">라이브 개봉 / 미개봉 발송 선택</span><% } %>
    </div>
    <% if (p.description) { %><div class="p-desc"><%= p.description %></div><% } %>
  </div>
  <a class="btn big block" href="/?p=<%= p.id %>"><%= s.live_on ? '담으러 가기' : '방송 중에만 주문할 수 있어요' %></a>
</main>
<%- include('../partials/foot') %>
