<%- include('../partials/head', { title: '포인트', bodyClass: '' }) %>
<% var T = { earn: '적립', use: '사용', revoke: '적립 회수', refund: '사용 취소', admin_add: '지급', admin_sub: '차감' }; %>
<main class="wrap page">
  <div class="page-title"><a class="back" href="/my" aria-label="뒤로">←</a>포인트</div>
  <section class="panel dark">
    <div style="color:#b9a9ab;font-size:13px">보유 포인트</div>
    <div style="font-family:var(--f-display);font-size:36px;color:var(--pink)" class="num"><%= fmt.num(user.point_balance) %>P</div>
    <div style="color:#b9a9ab;font-size:13px">계좌이체로 결제한 주문만 입금 확인 시 적립돼요<% if (s.point_earn_rate) { %> (<%= s.point_earn_rate %>%)<% } %>.</div>
  </section>
  <section class="panel">
    <h2>내역</h2>
    <% if (!list.length) { %><p class="hint" style="margin:0">아직 포인트 내역이 없어요</p><% } %>
    <% list.forEach(function (l) { %>
      <div style="display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)">
        <div><div style="font-weight:700"><%= T[l.type] || l.type %> <% if (l.order_no) { %><span style="color:var(--muted);font-weight:500;font-size:13px"><%= l.order_no %></span><% } %></div>
        <div style="color:var(--muted);font-size:12.5px"><%= fmt.dt(l.created_at) %><%= l.memo ? ' · ' + l.memo : '' %></div></div>
        <div style="text-align:right"><div class="num" style="font-weight:800;color:<%= l.amount > 0 ? 'var(--pink-dd)' : 'var(--ink)' %>"><%= l.amount > 0 ? '+' : '' %><%= fmt.num(l.amount) %>P</div><div class="num" style="color:var(--muted);font-size:12.5px"><%= fmt.num(l.balance_after) %>P</div></div>
      </div>
    <% }) %>
  </section>
</main>
<%- include('../partials/foot') %>
