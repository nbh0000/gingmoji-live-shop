<%- include('../partials/head', { title: '정보 입력', bodyClass: '' }) %>
<main class="wrap page">
  <div class="page-title">거의 다 됐어요 ♥</div>
  <form class="panel" method="post" action="/signup/profile">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <p style="margin:0 0 14px;color:var(--muted);font-size:14px">한 번만 입력하면 다음 주문부터 자동으로 채워져요.</p>
    <% if (error) { %><div class="err-box"><%= error %></div><% } %>
    <%- include('../partials/profile-fields', { form: form }) %>
    <label class="check"><input type="checkbox" name="agree" value="1" required> <span><a class="link" href="/page/terms" target="_blank">이용약관</a>과 <a class="link" href="/page/privacy" target="_blank">개인정보처리방침</a>에 동의합니다</span></label>
    <button class="btn big block pink" type="submit" style="margin-top:8px">저장하고 계속하기</button>
  </form>
</main>
<%- include('../partials/postcode') %>
<%- include('../partials/foot') %>
