<%- include('../partials/head', { title: '회원 정보', bodyClass: '' }) %>
<main class="wrap page">
  <div class="page-title"><a class="back" href="/my" aria-label="뒤로">←</a>회원 정보</div>
  <form class="panel" method="post" action="/my/profile">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (error) { %><div class="err-box"><%= error %></div><% } %>
    <%- include('../partials/profile-fields', { form: form }) %>
    <button class="btn big block" type="submit">저장</button>
  </form>
  <% if (user.login_id) { %>
  <form class="panel" method="post" action="/my/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2>비밀번호 변경</h2>
    <label class="field"><span>현재 비밀번호</span><input type="password" name="current" required autocomplete="current-password"></label>
    <label class="field"><span>새 비밀번호 (6자 이상)</span><input type="password" name="next" required minlength="6" autocomplete="new-password"></label>
    <button class="btn block ghost" type="submit">비밀번호 변경</button>
  </form>
  <% } else { %>
  <p class="hint"><%= user.kakao_id ? '카카오' : '구글' %> 계정으로 로그인한 회원입니다.</p>
  <% } %>
</main>
<%- include('../partials/postcode') %>
<%- include('../partials/foot') %>
