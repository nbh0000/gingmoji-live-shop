<%- include('../partials/head', { title: null, bodyClass: 'has-cartbar' }) %>
<section class="hero">
  <img src="/static/img/logo-wide.jpg" alt="GINGMOJI · TOYS · GOODS · RANDOM BOX · DOLL SHOP" width="1536" height="614">
</section>
<main class="wrap">
  <div class="banner <%= s.live_on ? '' : 'off' %>" data-live-banner>
    <span class="heart"><%= s.live_on ? '♥' : '✦' %></span>
    <span data-live-text><%= s.live_on ? '지금 방송 중! 담고 바로 주문하세요' : '방송 중에만 주문할 수 있어요. 방송 때 만나요!' %></span>
  </div>
  <% if (s.notice_text) { %><div class="notice"><%= s.notice_text %></div><% } %>

  <% var liveItems = products.filter(function (p) { return p.section !== 'sample'; });
     var sampleItems = products.filter(function (p) { return p.section === 'sample'; }); %>
  <h2 class="section-title">라이브 상품 <small><%= liveItems.length %>개</small></h2>
  <% if (!liveItems.length) { %>
    <div class="empty"><div class="big">?</div><p>방송 상품을 준비하고 있어요</p></div>
  <% } else { %>
  <div class="grid" data-grid>
    <% liveItems.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
  </div>
  <% } %>

  <h2 class="section-title sample">샘플 <small><%= sampleItems.length %>개</small></h2>
  <% if (!sampleItems.length) { %>
    <div class="empty small"><p>샘플 상품을 준비하고 있어요</p></div>
  <% } else { %>
  <div class="grid" data-grid>
    <% sampleItems.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
  </div>
  <% } %>
</main>
<div class="cartbar" data-cartbar>
  <button class="btn big" type="button" data-open-cart>
    <span>장바구니 보기</span>
    <span class="count num" data-cartbar-text>0개</span>
  </button>
</div>
<%- include('../partials/foot') %>
