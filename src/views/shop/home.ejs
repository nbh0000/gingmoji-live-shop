<%- include('../partials/head', { title: null, bodyClass: 'has-cartbar' }) %>
<section class="hero">
  <img src="/static/img/logo-wide.jpg" alt="GINGMOJI · TOYS · GOODS · RANDOM BOX · DOLL SHOP" width="1536" height="614">
</section>
<main class="wrap">
  <div class="banner <%= s.live_on ? '' : 'off' %>" data-live-banner>
    <span class="heart"><%= s.live_on ? '♥' : '✦' %></span>
    <span data-live-text><%= s.live_on ? '지금 방송 중! 담고 바로 주문하세요' : '방송 중에만 주문할 수 있어요. 방송 때 만나요!' %></span>
  </div>
  <% if (s.notice_text) { %><div class="notice"><%= s.notice_text %></div><% } %>

  <h2 class="section-title">라이브 상품 <small><%= products.length %>개</small></h2>
  <% if (!products.length) { %>
    <div class="empty"><div class="big">?</div><p>방송 상품을 준비하고 있어요</p></div>
  <% } else { %>
  <div class="grid" data-grid>
    <% products.forEach(function (p) { var out = p.is_soldout || p.stock <= 0; %>
    <button type="button" class="card <%= out ? 'soldout' : '' %>" data-product="<%= p.id %>"
      data-name="<%= p.name %>" data-price="<%= showPrice ? p.price : '' %>" data-stock="<%= p.stock %>"
      data-option="<%= p.use_open_option ? 1 : 0 %>" data-image="<%= p.image_id || '' %>">
      <div class="thumb"><% if (p.image_id) { %><img src="/img/<%= p.image_id %>" alt="" loading="lazy"><% } else { %><span class="ph">?</span><% } %></div>
      <div class="name"><%= p.name %></div>
      <div class="row">
        <div>
          <div class="price <%= showPrice ? '' : 'hidden' %>" data-price-label><%= showPrice ? fmt.won(p.price) : '방송 중 공개' %></div>
          <div class="stock-tag <%= !out && p.stock <= 3 ? 'low' : '' %>" data-stock-label><%= out ? '품절' : (p.stock <= 3 ? '남은 ' + p.stock + '개' : '') %></div>
        </div>
        <span class="add-dot" aria-hidden="true">+</span>
      </div>
    </button>
    <% }) %>
  </div>
  <% } %>
</main>
<div class="cartbar" data-cartbar>
  <button class="btn big" type="button" data-open-cart>
    <span>장바구니 보기</span>
    <span class="count num" data-cartbar-text>0개</span>
  </button>
</div>
<%- include('../partials/foot') %>
