<%- include('../partials/head', { title: '킵 보관함', bodyClass: '' }) %>
<% var pct = box.threshold ? Math.min(100, Math.round(box.keptAmount / box.threshold * 100)) : 0; %>
<main class="wrap page">
  <div class="page-title"><a class="back" href="/my" aria-label="뒤로">←</a>킵 보관함</div>

  <section class="panel">
    <div class="keep-meter">
      <div style="color:var(--muted);font-size:13px;font-weight:700">보관 중인 상품금액</div>
      <div class="keep-amount num"><%= fmt.won(box.keptAmount) %></div>
      <div class="meter" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"><i style="width:<%= pct %>%"></i></div>
      <div class="keep-left">
        <% if (!box.orders.length) { %>보관 중인 상품이 없어요. 주문할 때 "킵하기"를 고르면 여기에 모여요.
        <% } else if (box.remaining > 0) { %>무료배송까지 <b class="num"><%= fmt.won(box.remaining) %></b> · 지금 출고하면 배송비 <%= fmt.won(box.shippingFee) %>
        <% } else { %><b>무료배송 기준(<%= fmt.won(box.threshold) %>)을 넘었어요 ♥ 배송비 없이 출고돼요</b><% } %>
      </div>
    </div>
  </section>

  <% if (pendingShip) { %>
  <a class="panel tint" href="/my/shipments/<%= pendingShip.request_no %>" style="display:block;text-decoration:none">
    <h2 style="margin:0">배송비 결제를 기다리는 출고 요청이 있어요 <span class="side link">보기 →</span></h2>
  </a>
  <% } %>

  <% if (box.orders.length) { %>
  <section class="panel">
    <h2>보관 중 <span class="side" style="color:var(--muted)"><%= box.orders.length %>건</span></h2>
    <% box.orders.forEach(function (o) { %>
      <div style="padding:10px 0;border-bottom:1px solid var(--line)">
        <div class="top-row" style="display:flex;justify-content:space-between;gap:8px"><a class="link num" href="/orders/<%= o.order_no %>" style="font-size:13px"><%= o.order_no %></a><span class="num" style="font-weight:800"><%= fmt.won(o.items_amount) %></span></div>
        <% o.items.forEach(function (it) { %><div style="font-size:14px"><%= it.product_name %> <span style="color:var(--muted)"><%= fmt.optText(it) || ('× ' + it.qty) %></span></div><% }) %>
      </div>
    <% }) %>
  </section>

  <% if (!pendingShip) { %>
  <section class="panel" data-release data-fee="<%= box.fee %>">
    <h2>출고 요청</h2>
    <p style="margin:0 0 12px;font-size:14px;color:var(--muted)">보관 중인 상품 <b style="color:var(--ink)"><%= box.orders.length %>건</b>을 한 번에 보내드려요.</p>
    <label class="field"><span>받는 분</span><input name="name" value="<%= user.name %>" maxlength="50"></label>
    <label class="field"><span>휴대폰</span><input name="phone" value="<%= user.phone %>" type="tel" inputmode="numeric"></label>
    <div class="field"><span>주소</span>
      <div class="field-row"><input name="zipcode" value="<%= user.zipcode || '' %>" readonly placeholder="우편번호" style="max-width:130px" data-zip><button type="button" class="btn soft grow" data-postcode>주소 찾기</button></div>
      <input name="address1" value="<%= user.address1 %>" readonly data-addr1>
      <input name="address2" value="<%= user.address2 || '' %>" maxlength="255" placeholder="상세주소" data-addr2>
    </div>
    <label class="field"><span>배송 메모 (선택)</span><input name="memo" maxlength="255"></label>
    <% if (box.fee > 0) { %>
      <div style="font-weight:800;margin:8px 0">배송비 <%= fmt.won(box.fee) %> 결제</div>
      <div class="choices">
        <label class="choice"><input type="radio" name="payment" value="bank" <%= config.portone.enabled ? '' : 'checked' %>><span class="tile"><span class="t">🏦 계좌이체</span><span class="d"><%= s.bank_name %> 입금</span></span></label>
        <label class="choice"><input type="radio" name="payment" value="card" <%= config.portone.enabled ? 'checked' : 'disabled' %>><span class="tile"><span class="t">💳 카드결제</span><span class="d"><%= config.portone.enabled ? '바로 결제' : '준비 중이에요' %></span></span></label>
      </div>
      <label class="field" data-depositor style="margin-top:12px" <%= config.portone.enabled ? 'hidden' : '' %>><span>입금자명</span><input name="depositorName" value="<%= user.name %>" maxlength="50"></label>
    <% } %>
    <button class="btn big block pink" type="button" data-release-go style="margin-top:8px"><%= box.fee > 0 ? '배송비 ' + fmt.won(box.fee) + ' 결제하고 출고 요청' : '무료배송으로 출고 요청' %></button>
  </section>
  <% } %>
  <% } %>

  <% if (requests.length) { %>
  <section class="panel">
    <h2>출고 요청 내역</h2>
    <div class="list">
    <% requests.forEach(function (r) { %>
      <a class="item" href="/my/shipments/<%= r.request_no %>" style="box-shadow:none;background:#faf5f3">
        <div class="top-row"><span class="meta num"><%= fmt.dt(r.created_at) %></span><span class="chip <%= r.status === 'cancelled' ? 'gray' : (r.status === 'pending_payment' ? 'warn' : (r.status === 'shipped' ? 'dark' : 'ok')) %>"><%= ({ pending_payment: '배송비 결제대기', requested: '출고 요청', preparing: '배송준비', shipped: '발송완료', cancelled: '취소' })[r.status] %></span></div>
        <div class="top-row"><span class="num" style="font-weight:800"><%= fmt.won(r.kept_amount) %></span><span class="meta">배송비 <%= r.shipping_fee ? fmt.won(r.shipping_fee) : '무료' %></span></div>
      </a>
    <% }) %>
    </div>
  </section>
  <% } %>
</main>
<%- include('../partials/postcode') %>
<%- include('../partials/foot', { scripts: config.portone.enabled ? ['https://cdn.portone.io/v2/browser-sdk.js', '/static/js/pay.js?v=1'] : ['/static/js/pay.js?v=1'] }) %>
