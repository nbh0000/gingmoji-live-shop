<%- include('_head') %>
<div class="page-head"><h1>약관·정책</h1></div>
<div class="table-wrap">
  <table>
    <thead><tr><th>페이지</th><th>주소</th><th>최종 수정</th><th></th></tr></thead>
    <tbody>
    <% list.forEach(function (p) { %>
      <tr class="row"><td><b><%= p.title %></b></td><td><a href="/page/<%= p.slug %>" target="_blank">/page/<%= p.slug %> ↗</a></td><td class="num muted"><%= fmt.dt(p.updated_at) %></td><td><a class="btn sm" href="/admin/pages/<%= p.slug %>">편집</a></td></tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('_foot') %>
