<%- include('_head') %>
<div class="page-head"><h1><a href="/admin/products" class="muted" style="text-decoration:none">←</a> <%= isNew ? '상품 등록' : '상품 수정' %></h1></div>
<form method="post" action="<%= isNew ? '/admin/products/new' : '/admin/products/' + p.id %>?_csrf=<%= csrf %>" enctype="multipart/form-data" data-product-form>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <section class="card">
    <div class="form-grid">
      <label class="field full"><span>상품명</span><input name="name" value="<%= p.name || '' %>" required maxlength="200"></label>
      <label class="field"><span>가격 (원)</span><input name="price" type="number" min="0" step="100" value="<%= p.price || '' %>" required inputmode="numeric"></label>
      <label class="field"><span>재고</span><input name="stock" type="number" min="0" value="<%= p.stock || 0 %>" required inputmode="numeric"></label>
      <label class="field full"><span>상품 설명</span><textarea name="description" placeholder="구성, 크기, 주의사항 등 (PG 심사 시 상품정보로 확인됩니다)"><%= p.description || '' %></textarea></label>
      <label class="switch"><input type="checkbox" name="use_open_option" value="1" <%= p.use_open_option ? 'checked' : '' %>> <%= fmt.OPT.opened %> / <%= fmt.OPT.unopened %> 선택 사용</label>
      <label class="switch"><input type="checkbox" name="is_visible" value="1" <%= p.is_visible ? 'checked' : '' %>> 고객 화면에 노출</label>
      <label class="switch"><input type="checkbox" name="is_soldout" value="1" <%= p.is_soldout ? 'checked' : '' %>> 품절 처리</label>
    </div>
  </section>

  <section class="card" style="margin-top:14px">
    <h2>이미지 <span class="muted" style="font-size:12px;font-weight:500">첫 번째 이미지가 목록 썸네일이에요. 올릴 때 자동으로 줄여서 저장해요</span></h2>
    <% if (p.images && p.images.length) { %>
    <div class="images" style="margin-bottom:12px">
      <% p.images.forEach(function (img, i) { %>
        <div class="img">
          <% if (i === 0) { %><span class="badge-first">대표</span><% } %>
          <img src="/img/<%= img.id %>" alt="">
          <div class="actions">
            <% if (i > 0) { %><button class="btn sm ghost" type="submit" formaction="/admin/images/<%= img.id %>/first?_csrf=<%= csrf %>" formnovalidate>대표로</button><% } %>
            <button class="btn sm danger" type="submit" formaction="/admin/images/<%= img.id %>/delete?_csrf=<%= csrf %>" formnovalidate data-confirm="이미지를 삭제할까요?">삭제</button>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>
    <input type="file" name="images" accept="image/*" multiple data-resize>
    <div class="images" data-preview style="margin-top:10px"></div>
  </section>

  <div class="save-bar">
    <% if (!isNew) { %><button class="btn danger" type="submit" formaction="/admin/products/<%= p.id %>/delete?_csrf=<%= csrf %>" formnovalidate data-confirm="상품을 삭제할까요? 기존 주문 내역은 유지됩니다">삭제</button><% } %>
    <% if (!isNew) { %><a class="btn ghost" href="/p/<%= p.id %>" target="_blank">고객 화면 보기</a><% } %>
    <button class="btn pink lg" type="submit">저장</button>
  </div>
</form>
<%- include('_foot') %>
