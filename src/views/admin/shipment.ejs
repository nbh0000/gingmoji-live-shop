<%- include('_head') %>
<div class="page-head">
  <h1><a href="/admin/keep" class="muted" style="text-decoration:none">←</a> 킵 출고 요청</h1>
  <span class="chip <%= sr.status %>" style="font-size:14px;padding:4px 14px"><%= shipStatus(sr) %></span>
</div>
<div class="two">
  <div class="grid">
    <section class="card">
      <div class="nick" style="font-size:30px"><%= sr.youtube_nickname %></div>
      <div class="muted"><%= sr.request_no %> · <%= fmt.dt(sr.created_at) %></div>
      <dl class="kv" style="margin-top:12px">
        <dt>보관 금액</dt><dd class="num"><%= fmt.won(sr.kept_amount) %></dd>
        <dt>배송비</dt><dd><%= sr.shipping_fee ? fmt.won(sr.shipping_fee) + ' · ' + L.payment[sr.payment_method] + (sr.paid_at ? ' (결제 ' + fmt.dt(sr.paid_at) + ')' : ' (미결제)') : '무료' %></dd>
        <% if (sr.depositor_name) { %><dt>입금자명</dt><dd><%= sr.depositor_name %></dd><% } %>
        <dt>받는 분</dt><dd><%= sr.recipient_name %> · <%= fmt.phone(sr.recipient_phone) %></dd>
        <dt>주소</dt><dd><%= sr.zipcode ? '(' + sr.zipcode + ') ' : '' %><%= sr.address1 %> <%= sr.address2 %></dd>
        <dt>메모</dt><dd><%= sr.memo || '-' %></dd>
        <% if (sr.status === 'cancelled') { %><dt>취소</dt><dd><%= fmt.dt(sr.cancelled_at) %> · <%= L.cancel[sr.cancel_reason] || sr.cancel_reason %></dd><% } %>
      </dl>
      <div class="actions" style="margin-top:14px">
        <% if (sr.status === 'pending_payment' && sr.payment_method === 'bank') { %>
          <form method="post" action="/admin/shipments/<%= sr.id %>/confirm" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn lg ok" data-confirm="배송비 입금을 확인할까요?">배송비 입금 확인</button></form>
        <% } %>
        <% if (sr.status === 'requested') { %>
          <form method="post" action="/admin/shipments/<%= sr.id %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn soft" name="status" value="preparing">배송준비로 변경</button></form>
        <% } %>
        <% if (sr.status !== 'cancelled' && sr.status !== 'shipped') { %>
          <form method="post" action="/admin/shipments/<%= sr.id %>/cancel" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger" data-confirm="출고 요청을 취소할까요? 주문들은 다시 킵보관 상태가 됩니다">출고 요청 취소</button></form>
        <% } %>
      </div>
    </section>
    <% if (['requested', 'preparing', 'shipped'].indexOf(sr.status) >= 0) { %>
    <section class="card">
      <h2>송장 · 발송 처리</h2>
      <form method="post" action="/admin/shipments/<%= sr.id %>/status" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="shipped">
        <label class="field"><span>택배사</span><input name="courier" value="<%= sr.courier || 'CJ대한통운' %>" list="couriers"></label>
        <label class="field"><span>송장번호</span><input name="tracking_no" value="<%= sr.tracking_no || '' %>" inputmode="numeric" required></label>
        <div class="full"><button class="btn" type="submit" <%= sr.status === 'shipped' ? 'disabled' : '' %>>송장 저장 · 발송완료</button></div>
      </form>
      <datalist id="couriers"><option>CJ대한통운</option><option>우체국택배</option><option>한진택배</option><option>롯데택배</option><option>로젠택배</option></datalist>
    </section>
    <% } %>
  </div>
  <section class="card">
    <h2>포함된 주문 (<%= list.length %>건) — 포장 목록</h2>
    <table>
      <thead><tr><th>주문</th><th>상품</th><th class="right">금액</th></tr></thead>
      <tbody>
      <% list.forEach(function (o) { %>
        <tr><td><a class="num" href="/admin/orders/<%= o.id %>"><%= o.order_no %></a><div class="muted" style="font-size:12px"><%= fmt.date(o.paid_at) %></div></td>
          <td class="items"><% o.items.forEach(function (it) { %><div><%= it.product_name %> ×<%= it.qty %><% if (it.qty_opened || it.qty_unopened) { %> <span class="opt">(<%= fmt.optText(it) %>)</span><% } %></div><% }) %></td>
          <td class="right num"><%= fmt.won(o.items_amount) %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </section>
</div>
<%- include('_foot') %>
