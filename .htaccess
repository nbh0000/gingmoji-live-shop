DirectoryIndex index.php
Options -Indexes
RewriteEngine On

# 기존 Node public 자산을 PHP 호스팅에서도 같은 URL로 제공합니다.
RewriteRule ^static/(.*)$ src/public/$1 [L]
RewriteRule ^img/([0-9]+)$ index.php?route=image&id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
