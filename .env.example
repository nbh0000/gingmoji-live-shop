# ===== 서버 =====
# 카페24 Node.js 호스팅은 8001 포트를 사용합니다.
PORT=8001
NODE_ENV=production
# 외부에서 접속하는 기본 주소 (OAuth 콜백, 결제 리다이렉트에 사용). 끝에 / 없이
BASE_URL=http://아이디.cafe24app.com
SESSION_SECRET=아주-긴-랜덤-문자열로-바꾸세요

# ===== DB (카페24 호스팅 MariaDB) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=카페24DB아이디
DB_PASSWORD=카페24DB비밀번호
DB_NAME=카페24DB이름

# ===== 관리자 (1명) =====
ADMIN_ID=admin
ADMIN_PASSWORD=관리자비밀번호를바꾸세요

# ===== 카카오 로그인 =====
# developers.kakao.com > 내 애플리케이션 > 앱 키(REST API 키), 보안 > Client Secret
# Redirect URI: {BASE_URL}/auth/kakao/callback
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=

# ===== 구글 로그인 =====
# console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
# 승인된 리디렉션 URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 포트원(PortOne) V2 =====
# admin.portone.io > 결제 연동 > 연동 정보. 테스트 채널 키로 시작하고, 심사 후 실 채널 키로 교체만 하면 됩니다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 웹훅 URL: {BASE_URL}/api/payments/webhook , 시크릿은 whsec_ 로 시작
PORTONE_WEBHOOK_SECRET=
